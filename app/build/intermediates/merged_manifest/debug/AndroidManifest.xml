<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.wastrain"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <permission
        android:name="com.example.wastrain.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.wastrain.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/wastrain_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/wastrain_logo"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.WastraIN" >
        <activity
            android:name="com.example.wastrain.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.WastraIN" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.wastrain.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.ClassificationActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.ClassificationResultActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.MotifInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.CollectionActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.LaboratoriumAiActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.PaletWastraActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />
        <activity
            android:name="com.example.wastrain.JejakAiActivity"
            android:exported="false"
            android:theme="@style/Theme.WastraIN" />

        <service
            android:name="androidx.camera.core.impl.MetadataHolderService"
            android:enabled="false"
            android:exported="false" >
            <meta-data
                android:name="androidx.camera.core.impl.MetadataHolderService.DEFAULT_CONFIG_PROVIDER"
                android:value="androidx.camera.camera2.Camera2Config$DefaultProvider" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.wastrain.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>